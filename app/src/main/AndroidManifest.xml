<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 网络：局域网 HTTP 服务 + 扫码连接 ============ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 前台服务保活：CPU 与 WiFi 锁，熄屏后仍能持续传输 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ============ 前台服务 + 常驻通知 ============ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ============ 扫码 ============ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- ============ 文件：统一保存到 /storage/emulated/0/Luobo/ ============ -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 接收到的文件放在共享存储根目录 /storage/emulated/0/Luobo/（不在 MediaStore 允许的应用自有目录内），
         因此 Android 11+ 需要「所有文件访问权限」；未授权时会自动降级到应用私有目录。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".LuoboApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Luobo"
        android:usesCleartextTraffic="true">

        <!-- 主界面：共享开关 / 二维码 / 网址 / 传输板 / 输入栏 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 从其它应用「分享」文本/任意文件到萝卜快传 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 扫一扫：扫描主机二维码，作为客户端加入对方传输板 -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:theme="@style/Theme.Luobo.Scan" />

        <!-- 前台服务：承载 NanoHTTPD 局域网 HTTP 服务 -->
        <receiver
            android:name=".notify.ClipboardReceiver"
            android:exported="false" />
        <service
            android:name=".service.HttpServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 打开/分享已接收文件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
