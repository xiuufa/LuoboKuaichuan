<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 主界面主题：Material3 + 萝卜橙品牌色 -->
    <style name="Theme.Luobo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/luobo_primary</item>
        <item name="colorOnPrimary">@color/luobo_on_primary</item>
        <item name="colorPrimaryContainer">@color/luobo_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/luobo_on_primary_container</item>
        <item name="colorSecondary">@color/luobo_secondary</item>
        <item name="colorOnSecondary">@color/luobo_on_secondary</item>
        <item name="colorSecondaryContainer">@color/luobo_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/luobo_on_secondary_container</item>
        <item name="android:colorBackground">@color/luobo_surface</item>
        <item name="colorSurface">@color/luobo_surface</item>
        <item name="colorOnSurface">@color/luobo_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/luobo_on_surface_variant</item>
        <item name="colorOutline">@color/luobo_outline</item>
        <item name="android:statusBarColor">@color/luobo_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 扫码页：全屏黑底 -->
    <style name="Theme.Luobo.Scan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
